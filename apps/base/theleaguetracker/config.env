# Non-secret settings for The League Tracker, as KEY=value lines (no quotes:
# kustomize keeps them literally). Generated into the theleaguetracker-config
# ConfigMap with a content hash in its name, so any change here rolls the pod.
# Secrets (APP_KEY, mail credentials) are in the overlay's sops-encrypted secret.

APP_NAME=The League Tracker
APP_ENV=production
APP_DEBUG=false
APP_URL=https://theleaguetracker.com
APP_TIMEZONE=America/Toronto
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Shown on the privacy and terms pages and as the footer Contact link.
CONTACT_EMAIL=hello@theleaguetracker.com
LEAGUE_LIMIT=5
GOOGLE_SITE_VERIFICATION=

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/app/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=10080
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOGO_DISK=public

# Transactional email (sign-up confirmation, password reset, invitations),
# sent through Proton Mail. MAIL_USERNAME (the sending address) and
# MAIL_PASSWORD (a Proton SMTP token) are in theleaguetracker-secrets.
# MAIL_FROM_ADDRESS must be the same address as MAIL_USERNAME.
MAIL_MAILER=smtp
MAIL_HOST=smtp.protonmail.ch
MAIL_PORT=587
# STARTTLS on 587
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=admin@theleaguetracker.com
MAIL_FROM_NAME=The League Tracker

# Start-up behaviour of the container (docker/entrypoint.sh).
RUN_MIGRATIONS=true
SEED_SPORTS=true
